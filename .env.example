# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ── Supabase Cloud ────────────────────────────────────────
# Server-only. Bypasses RLS entirely — this is the ONLY way the app talks
# to Supabase (Telegram webhook AND the dashboard). Identity is Firebase,
# not Supabase Auth, so there is no Supabase session for RLS to key off —
# every query issued through this client is scoped by organization_id in
# application code instead. Never expose this key to the browser. See
# docs/architecture.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase Authentication ───────────────────────────────
# Dashboard user identity. Server-only (Admin SDK) — used to verify ID
# tokens and mint the httpOnly session cookie; never expose these to the
# browser. From your Firebase project's service account
# (Project settings → Service accounts → Generate new private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-safe. Used by the browser Firebase SDK to sign in/up/out, and by
# test scripts to call Firebase's Identity Toolkit REST API directly. From
# your Firebase project's web app config (Project settings → General →
# Your apps → SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── AI (OpenRouter) ───────────────────────────────────────
# Also required (real key) to run `npm run test:ai` — the real OpenRouter
# integration test. See README.md before running it; it spends real credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── Telegram ──────────────────────────────────────────────
# Per-organization bot tokens AND webhook secrets live in the
# telegram_integrations table, not env vars — the webhook route verifies
# the X-Telegram-Bot-Api-Secret-Token header against that row per request.
# Nothing to configure here.

# ── Cron ──────────────────────────────────────────────────
# Server-only. Authorizes calls to /api/cron/send-follow-ups (see
# vercel.json). Vercel automatically sends this as an Authorization: Bearer
# header when a cron job it manages calls the route — set the same value
# here and in your Vercel project's environment variables. Generate with
# e.g. `openssl rand -hex 32`. Without this set, the cron route refuses to
# run rather than being callable by anyone who finds the URL.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
